{
  // ============================================================================
  // 突击莉莉桌宠 · 台词配置文件
  // 本文件由桌宠内置"设置 → 台词与场景"维护,也可用"梨璃交互编辑器"或文本编辑器手动修改。
  // 每个"场景编号"是一个键,值为发言数组,桌宠会随机从中挑选一句。
  // 修改保存后即时生效;删除键/数组留空会回退内置默认台词。
  // ============================================================================

  // ---- 场景互动设置(可在设置 → 台词与场景 中修改) ----
  "_settings": {
    "allowInterrupt": true, // 是否允许场景互动打断当前发言/动作
    "cooldowns": { // 各场景互动/身体部位点击的冷却(毫秒);0 = 不限制
      "10_typing": 4000,
      "11_clicking": 6000,
      "12_mousemove": 12000,
      "13_highcpu": 30000,
      "14_media": 10000,
      "16_mediaStop": 10000,
      "20_partHead": 3000,
      "21_partArmL": 3000,
      "22_partArmR": 3000,
      "23_partTorso": 3000,
      "24_partLegs": 3000
    }
  },
  // ---- 01_greeting 启动问候(桌宠出现时说的第一句话) ----
  "01_greeting": [
    "你好！我是一柳梨璃，请多关照！",
    "今天也要一起加油哦☆",
    "一柳队，准备出击！"
  ],

  // ---- 02_random 通用随机台词(点击宠物 / 自动说话时随机挑选) ----
  "02_random": [
    "我是一柳梨璃！请多关照！",
    "今天也要一起加油哦☆",
    "想成为姐姐大人的话，可不能偷懒呢！",
    "呼啊……好想睡觉……不行不行，训练要紧！",
    "这个敌人就交给我吧！",
    "别、别捏我的脸啦！",
    "唔……有点饿了，训练完要好好吃饭！",
    "你的手好暖和……",
    "梦结大人在的话，一定又会说我发呆了吧……",
    "哼，这点小事算什么！",
    "我会好好守护大家的！"
  ],

  // ---- 03_doubleClick 双击表情(双击宠物切换表情时) ----
  "03_doubleClick": [
    "嘻嘻～怎么样？",
    "怎样？可爱吧！"
  ],

  // ---- 04_wakeUp 被点击唤醒(点击睡着的梨璃唤醒时) ----
  "04_wakeUp": [
    "啊！我睡着了吗！",
    "唔……该去训练了！",
    "梦到和梦结大人一起出击了……"
  ],

  // ---- 05_wakeGrumpy 被吵醒(起床气)(睡觉时被键盘/鼠标声吵醒) ----
  "05_wakeGrumpy": [
    "唔……你敲键盘的声音太大啦！",
    "吵醒梨璃了！在忙什么呀？",
    "Zzz……啊！谁在疯狂点点点！"
  ],

  // ---- 06_sleep 入睡气泡(睡着时的 Zzz 气泡) ----
  "06_sleep": [
    "Zzz……"
  ],

  // ---- 10_typing 连续打字(3 秒内 ≥5 次按键) ----
  "10_typing": [
    "噼里啪啦的……打字好快呀！是在写作战报告吗？",
    "打字像操作 CHARM 一样熟练呢！",
    "键盘都要冒烟啦！休息一下比较好哦？",
    "在工作吗？梨璃给你加油！",
    "唔……我也想学会这么快的打字……"
  ],

  // ---- 11_clicking 连续点击(2 秒内 ≥4 次鼠标点击) ----
  "11_clicking": [
    "哒哒哒……点这么快，在打游戏吗？",
    "手速不错嘛！要跟梨璃比试一下吗？",
    "连续点击……是发现了什么大敌人吗？",
    "再点下去，鼠标会像 CHARM 一样过热的！"
  ],

  // ---- 12_mousemove 持续滑鼠(连续移动 2.2 秒) ----
  "12_mousemove": [
    "鼠标滑来滑去的，在找什么呀？",
    "绕来绕去……是迷路了吗？让我来带路吧！",
    "转得我头都晕啦～",
    "在翻资料吗？需要梨璃帮忙吗？"
  ],

  // ---- 13_highcpu CPU 高占用(≥70% 持续 5 秒) ----
  "13_highcpu": [
    "电脑好像有点吃力……像梨璃训练过度的样子！",
    "风扇转得好大声……辛苦啦！",
    "CPU 都拉满啦，休息一下吧？",
    "唔……有点发热，要好好爱护它哦！"
  ],

  // ---- 14_media 播放视频(检测到视频播放) ----
  "14_media": [
    "在看视频吗？好看吗！",
    "屏幕上好热闹，梨璃也凑过来看啦",
    "又看番又打游戏，真羡慕呀！",
    "有声音……你在看什么呀？"
  ],

  // ---- 15_mediaMusic 播放音乐(检测到音乐播放) ----
  "15_mediaMusic": [
    "在听歌呀？梨璃也想听～",
    "这旋律……好想跟着一起唱！",
    "音乐真好听，一起享受吧☆",
    "这首歌好像在哪里听过……是训练时放的曲子吗？"
  ],

  // ---- 16_mediaStop 停止播放(媒体停止播放) ----
  "16_mediaStop": [
    "啊，不看了吗？那来陪梨璃玩吧！",
    "这么快就看完啦？"
  ],

  // ---- 20_partHead 摸头(点击头部区域) ----
  "20_partHead": [
    "嘿嘿，摸摸头～",
    "别摸啦，头发会乱掉的！",
    "会长不高的！",
    "好、好舒服……再摸一下下也可以……"
  ],

  // ---- 21_partArmL 摸左臂(点击左臂区域) ----
  "21_partArmL": [
    "左手还要拿装备呢！"
  ],

  // ---- 22_partArmR 摸右臂(点击右臂区域) ----
  "22_partArmR": [
    "啊！差点把 CHARM 弄掉了！"
  ],

  // ---- 23_partTorso 摸肚子(点击躯干区域) ----
  "23_partTorso": [
    "好痒！",
    "这里不能随便碰啦！",
    "哈哈……别挠啦！"
  ],

  // ---- 24_partLegs 摸腿(点击腿部 / 裙子区域) ----
  "24_partLegs": [
    "呀！这里不可以碰哦！",
    "裙子会飞起来的！",
    "唔……痒痒的！"
  ],

  // ---- 场景动作映射(可选,留空则只说话) ----
  "motions": {
    "10_typing": "think",
    "11_clicking": "positive",
    "12_mousemove": "think",
    "13_highcpu": "negative",
    "14_media": "fun",
    "15_mediaMusic": "fun",
    "16_mediaStop": "shy"
  },
  "partMotions": {
    "20_partHead": "",
    "21_partArmL": "",
    "22_partArmR": "",
    "23_partTorso": "",
    "24_partLegs": ""
  }
}